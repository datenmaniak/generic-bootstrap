#!/usr/bin/bash

# Para instalar Alacritty en AlmaLinux, puedes compilarlo desde 
# el código fuente con Rust o utilizar un repositorio comunitario/COPR. 
# El método más directo y recomendado es compilarlo tras instalar sus 
# dependencias y el compilador de Rust.

##  Instala las herramientas de desarrollo y dependencias necesarias:

sudo dnf groupinstall -y "Development Tools"
sudo dnf install -y cmake freetype-devel fontconfig-devel libxcb-devel libxkbcommon-devel python3

echo "[INFO] Instalar Rust utilizando rustup..."
echo "[INFO] Sigue las instrucciones en pantalla (presiona 1 para la instalación estándar). Luego, recarga el entorno de tu shell:"

##  Instala Rust utilizando rustup:

curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

source "$HOME/.cargo/env"
echo "[INFO] Entorno del Shell recargado!"

## Clona el repositorio oficial de Alacritty:

echo "[INFO] Clonacion de Alacritty..."

git clone https://github.com/alacritty/alacritty.git
cd alacritty


## Compila e instala Alacritty:

echo "[INFO] Compilacion de Alacritty..."
cargo build --release


## Configura el binario, el archivo terminfo y el acceso directo de escritorio:
sudo cp target/release/alacritty /usr/local/bin
sudo cp extra/logo/alacritty-term.svg /usr/share/pixmaps/Alacritty.svg
sudo desktop-file-install extra/linux/Alacritty.desktop
sudo update-desktop-database
sudo tic -xe alacritty,alacritty-direct extra/alacritty.info

echo "[INFO] Completada la instalacion!"

echo [INFO] Limpieza de entorno de compilacion completada"
rm -rf alacritty
rm -rf ~/alacritty




