#!/usr/bin/env bash
set -euo pipefail

GITHUB_USERNAME="datenmaniak"
GPGKEY="$HOME/generic-bootstrap/privatekey"
ZSHRC="$HOME/.zshrc"

# echo "==> Importando clave GPG..."
if [[ -f "$GPGKEY" ]]; then
  gpg --import "$GPGKEY"
else
  echo -e "AVISO: No se encontró la clave privada GPG..!"
  echo -e "Los dotfiles cifrados no podrán descifrarse hasta importarla\n"
  echo -e "Haz una copia de la llave privada dentro del directorio\n"
  echo "    - cp <my-pprivate-key.asc>  ~/generic-bootstrap/privatekey  "
  echo -e "    - ejecuta nuevamente \`.setup\` \n"
  echo -e "\n --- privatekey --- será eliminada al finalizar este proceso --- "
  echo "Los dotfiles cifrados no podrán descifrarse hasta importarla."
  exit 1
fi

echo "==> Creando directorios de configuración..."
mkdir -p "$HOME/.config" "$HOME/.local/bin"

echo "==> Instalando Mise..."
curl -fsSL https://mise.run | sh

# Hacer disponible Mise en esta sesión del script
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

echo "==> Verificando Mise..."
mise --version

# echo "==> Instalando Chezmoi mediante Mise..."
mise use --global chezmoi@latest
mise install
#

echo "==> Configurando activación de Mise en Zsh..."
cat >>"$ZSHRC" <<'EOF'

# Activa Mise en Zsh
eval "$(mise activate zsh)"
# -- MISE-TOOLS ---
EOF

echo "==> Inicializando y aplicando dotfiles..."
chezmoi init --apply https://github.com/${GITHUB_USERNAME}/generic-dotfiles.git

echo "==> Instalando herramientas declaradas por Mise..."
mise install
mise reshim

echo "==> Configurando Starship y fzf en Zsh..."
if grep -q "MISE-TOOLS" "$ZSHRC" 2>/dev/null; then
  cat >>"$ZSHRC" <<'EOF'
# --- Added by "workstation_bootstrap" by using Mise ---
eval "$(mise activate zsh)"
# -- Installed apps by Mise 
eval "$(starship init zsh)"
source <(fzf --zsh)
# -- end bootstrap MISE-TOOLS --
EOF

fi

# if [[ -d "$HOME/.local/share/chezmoi/scripts" ]]; then
#   ln -sf "$HOME/.local/share/chezmoi/scripts" "$HOME/.scripts"
#   echo "==> Creado enlace a los scrips personalizados!"
# else
#   echo "Ningun script!"
# fi

echo "==> Migración completada."
rm "$GPGKEY"
echo "Reinicia la consola!"
